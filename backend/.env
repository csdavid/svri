# Configuración de Base de Datos PostgreSQL para SVRI (Contenedor Docker: svri-postgres)
DATABASE_URL=postgresql+psycopg://svri_user:svri_password123@localhost:5433/svri_db

# Parámetros individuales de conexión
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=svri_user
POSTGRES_PASSWORD=svri_password123
POSTGRES_DB=svri_db

# Servidor Backend
PORT=8008
HOST=0.0.0.0
